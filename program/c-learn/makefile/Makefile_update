#引入变量名，避免重复工作
OBJ = test.o add.o sub.o mul.o div.o
TARGET = test
GCC = gcc
$(TARGET) : $(OBJ)
	$(GCC) $(OBJ) -o $(TARGET) 

$(TARGET).o : $(TARGET).c
	$(GCC) -c $(TARGET).c -o $(TARGET).o

add.o : add.c
	$(GCC) -c add.c -o add.o

sub.o : sub.c
	$(GCC) -c sub.c -o sub.o

mul.o : mul.c
	$(GCC) -c mul.c -o mul.o

div.o : div.c
	$(GCC) -c div.c -o div.o
