{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            // 当前打开cpp编译出来exe：同目录下同名exe
            "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            
            //"environment": [],
            "environment": [
                {"name": "LC_ALL", "value": "C.UTF-8"},
                {"name": "LANG", "value": "C.UTF-8"}
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            // =========这里改成你自己mingw64下gdb.exe完整路径=========
            "miDebuggerPath": "D:/cpath/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
